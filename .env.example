# Copie este arquivo para .env e ajuste se precisar. O .env não vai para o Git.

# Porta do servidor
PORTA=3000

# 127.0.0.1 = só este computador. 0.0.0.0 = outros aparelhos da mesma rede também acessam.
HOST=127.0.0.1

# Arquivo do banco de dados (padrão: backend/dados/dosecerta.db)
# BANCO=backend/dados/dosecerta.db

# 1 quando o site estiver em HTTPS (o cookie de sessão só trafega criptografado)
COOKIE_SEGURO=0

# 0 para não criar as contas de teste (use 0 em produção)
CONTAS_TESTE=1

# 0 para desligar o avanço automático dos pedidos do app
PROCESSAR_FILA=1
